# 从仓库根目录启动；必须明确选 real 或 mock。此处选择 mock 供离线验收。
APP_MODE=mock
DATA_DIR=data/mock
# 留空时由 DATA_DIR 推导；real 模式请换 DATA_DIR，避免混用索引。
# DB_PATH=data/mock/library.sqlite
# FILES_DIR=data/mock/raw
# INDEX_DIR=data/mock/indexes
API_BASE_URL=http://127.0.0.1:8000
MAX_UPLOAD_MB=25
# 当前明确使用字符计数，避免离线时下载 tokenizer；不冒充 token 统计。
CHUNKING_CONFIG={"count_mode":"character","tokenizer_name":null,"tokenizer_revision":null,"max_tokens":400,"overlap_tokens":50,"max_chars":1200,"overlap_chars":150}
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_PROVIDER=siliconflow
# 云服务没有可固定的修订，留空，不填 HuggingFace 修订。
EMBEDDING_REVISION=
EMBEDDING_DIMENSION=1024
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_PROVIDER=siliconflow
LLM_MODEL=Qwen/Qwen3-32B
LLM_ENABLE_THINKING=false
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=1800
# 更换模型时核对实际服务上下文上限；C 会保守检查输入与输出总预算。
LLM_CONTEXT_WINDOW_TOKENS=32768
# C 已接入：D 装配工厂，返回 C 的 SiliconFlowLLM（LLM_API_KEY 为空时回退 SILICONFLOW_API_KEY）
LLM_CLIENT_FACTORY=dlrag.api.qa_factory:create_client
QA_BILINGUAL_RETRIEVAL_ENABLED=true
# v1.0: conservative UTF-8 byte upper bound, not an actual tokenizer count.
QA_CONTEXT_BUDGET_TOKENS=24000
QA_MAX_EVIDENCE_CHUNKS=8
QA_EVIDENCE_RERANK_ENABLED=true
QA_SEMANTIC_RERANK_ENABLED=true
QA_RERANK_MODEL=Qwen/Qwen3-Reranker-4B
QA_RERANK_PROVIDER=siliconflow
QA_RERANK_TIMEOUT_SECONDS=20
QA_REFERENCE_PENALTY_ENABLED=true
QA_NEIGHBOR_EXPANSION_ENABLED=true
QA_NEIGHBOR_RADIUS=1
QA_NEIGHBOR_SEED_K=3
METADATA_API_ENABLED=true
METADATA_API_MODEL=Qwen/Qwen3-VL-8B-Instruct
METADATA_API_PROVIDER=siliconflow
METADATA_API_TIMEOUT_SECONDS=45
# Only used when the user explicitly selects bibliographic enrichment.
METADATA_LOOKUP_ENABLED=true
METADATA_LOOKUP_TIMEOUT_SECONDS=10

